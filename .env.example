# Copy to .env and fill only your own values.
# Never commit .env.

SMC_TG_TOKEN=
SMC_TG_CHAT_ID=

# MT5 Python does not expose a universal broker-server IANA timezone.
# Set this to the actual broker server timezone if you need broker-local
# display/scheduling. UTC remains the canonical internal timestamp.
SMC_BROKER_TIMEZONE=UTC

# Safety: live execution is OFF by default.
SMC_DRY_RUN=true

SMC_RISK_PER_TRADE=0.005
SMC_DAILY_LOSS_LIMIT=0.02
SMC_HARD_RISK_CEILING=0.01
SMC_MAX_TRADES_PER_DAY=3
SMC_MAX_CONSECUTIVE_LOSSES=2
SMC_COOLDOWN_MINUTES=30
SMC_MIN_RR=2.5

SMC_STATE_DB=smc_state.sqlite3
SMC_LOG_PATH=smc_trade_log.jsonl
